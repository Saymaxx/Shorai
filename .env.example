# =================================================================
# SHORAI ENVIRONMENT CONFIGURATION
# =================================================================

# 1. Admin Dashboard Passkey (Required for /admin Visual CMS)
ADMIN_SECRET=shorai_admin_secret_2026

# 2. Google Apps Script Webhook URL (For Google Sheets lead capture)
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYED_WEB_APP_ID/exec

# 3. AI Assistant (Gemini API Key for live AI chatbot)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 4. Email Notification Settings (Optional - SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@shorai.in
SMTP_PASS=your_email_app_password
ADMIN_EMAIL=contact@shorai.in

# 5. Server Environment
NODE_ENV=production
